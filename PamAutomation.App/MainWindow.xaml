<Window x:Class="PamAutomation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accesos PAM"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="44,30,44,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MaxWidth="1320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="60"
                            Height="60"
                            Background="{StaticResource NavyBrush}"
                            CornerRadius="16"
                            Effect="{StaticResource SoftShadowEffect}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Text="P" />
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Text="Accesos PAM" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14"
                                   Text="BeyondInsight Password Safe" />
                    </StackPanel>
                </StackPanel>

                <ToggleButton Grid.Column="1"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Seleccionar acción final"
                              Command="{Binding ToggleFinalActionCommand}"
                              IsChecked="{Binding SendEmailAtEnd, Mode=OneWay}"
                              IsEnabled="{Binding AreControlsEnabled}"
                              Style="{StaticResource OutlookActionToggleStyle}" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" />
        </Grid>

        <Grid Grid.Row="1" Margin="44,24,44,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Width="585"
                        AutomationProperties.Name="Iniciar automatización PAM"
                        Command="{Binding StartAutomationCommand}"
                        Content="Iniciar automatización"
                        IsEnabled="{Binding CanStartAutomation}"
                        Style="{StaticResource HeroButtonStyle}" />

                <Button Margin="0,18,0,0"
                        MinWidth="250"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Iniciar prueba segura"
                        Command="{Binding StartTestCommand}"
                        Content="Iniciar prueba">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TestButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTestActionVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ProgressBar Width="585"
                             Margin="0,18,0,0"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource RunProgressBarStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Width="585"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           Text="{Binding StatusMessage}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Border Width="585"
                        MaxHeight="190"
                        Margin="0,18,0,0"
                        Padding="20"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        AutomationProperties.Name="Resultado de la automatización">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Text="{Binding ResultTitle}" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding ResultSummary}"
                                   TextWrapping="Wrap" />
                        <ScrollViewer MaxHeight="95"
                                      Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock FontFamily="Consolas"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding RequestIdsText}" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

                <UniformGrid Grid.Row="1"
                             MaxWidth="1030"
                             Margin="0,30,0,0"
                             HorizontalAlignment="Stretch"
                             Columns="3">
                <Button Margin="0,0,10,0"
                        AutomationProperties.Name="Configurar credenciales PAM"
                        Command="{Binding ConfigureCredentialsCommand}"
                        Style="{StaticResource NavigationCardButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding CredentialsActionText}" />
                        <TextBlock Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Text="→" />
                    </Grid>
                </Button>

                <Button Margin="10,0"
                        AutomationProperties.Name="Configurar solicitud PAM"
                        Command="{Binding ConfigureRequestCommand}"
                        Style="{StaticResource NavigationCardButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding RequestActionText}" />
                        <TextBlock Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Text="→" />
                    </Grid>
                </Button>

                <Button Margin="10,0,0,0"
                        AutomationProperties.Name="Configurar envío de correo"
                        Command="{Binding ConfigureMailCommand}"
                        Style="{StaticResource NavigationCardButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding MailActionText}" />
                        <TextBlock Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Text="→" />
                    </Grid>
                </Button>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
