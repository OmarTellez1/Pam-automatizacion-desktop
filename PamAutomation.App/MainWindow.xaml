<Window x:Class="PamAutomation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ApplicationDisplayName}"
        Width="1050"
        Height="660"
        MinWidth="800"
        MinHeight="540"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,20,30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MaxWidth="1320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border x:Name="BrandMonogramBadge"
                            Width="48"
                            Height="48"
                            Background="{StaticResource NavyBrush}"
                            CornerRadius="16"
                            Effect="{StaticResource SoftShadowEffect}">
                        <TextBlock x:Name="BrandMonogram"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Monograma PA de PAM Automation"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Text="PA" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Text="{Binding ApplicationDisplayName}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Text="BeyondInsight Password Safe" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="AccessPamButton"
                            Width="135"
                            Height="40"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="Acceder a PAM"
                            Command="{Binding AccessPamCommand}"
                            Content="Acceder a PAM"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Abre BeyondInsight e inicia sesión con las credenciales PAM configuradas." />
                    <Button x:Name="PamAccountsButton"
                            Width="130"
                            Height="40"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="Administrar usuarios PAM"
                            Command="{Binding OpenPamAccountsCommand}"
                            Content="Usuarios PAM"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Border MinWidth="170"
                            Height="48"
                            Padding="7,4,14,4"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            AutomationProperties.Name="Usuario principal activo">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" Background="{StaticResource NavyBrush}" CornerRadius="10">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Text="{Binding PrincipalAccountInitial, Mode=OneWay}" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           Text="Usuario principal" />
                                <TextBlock MaxWidth="180"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="{Binding PrincipalAccountName, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" />
        </Grid>

        <Grid Grid.Row="1" Margin="30,18,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="UpdateNotificationBanner"
                    Grid.Row="0"
                    MaxWidth="920"
                    Margin="0,0,0,14"
                    Padding="16,10"
                    Background="#FFF6DA"
                    BorderBrush="#E4B028"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.Name="Actualización disponible">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding UpdateNotificationMessage}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Width="28"
                            Height="28"
                            Margin="14,0,0,0"
                            Padding="0"
                            AutomationProperties.Name="Cerrar aviso de actualización"
                            Command="{Binding DismissUpdateCommand}"
                            Content="×"
                            FontSize="18"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Width="500"
                        AutomationProperties.Name="Iniciar automatización PAM"
                        Command="{Binding StartAutomationCommand}"
                        Content="Iniciar automatización"
                        IsEnabled="{Binding CanStartAutomation}"
                        Style="{StaticResource HeroButtonStyle}" />

                <Button Margin="0,14,0,0"
                        MinWidth="250"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Iniciar prueba segura"
                        Command="{Binding StartTestCommand}"
                        Content="Iniciar prueba">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TestButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTestActionVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ProgressBar Width="500"
                             Margin="0,14,0,0"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource RunProgressBarStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Border x:Name="StartAutomationWarningBanner"
                        Width="500"
                        Margin="0,16,0,0"
                        Padding="12,10"
                        Background="#FFF7E8"
                        BorderBrush="#F0B44D"
                        BorderThickness="1"
                        CornerRadius="10"
                        AutomationProperties.Name="Motivo por el que no se puede iniciar la automatización">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStartAutomationWarningVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="#8A4B08"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="{Binding StartAutomationWarningMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="AutomationStatusText"
                           Width="500"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           Text="{Binding StatusMessage}"
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button x:Name="ShowAutomationResultButton"
                        MinWidth="230"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Ver resultado de la automatización"
                        Command="{Binding ShowResultCommand}"
                        Content="Ver resultado de la automatización">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Grid Grid.Row="2"
                  MaxWidth="920"
                  Margin="0,20,0,0"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="ExportDiagnosticsButton"
                            Width="180"
                            Height="40"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="Exportar diagnóstico"
                            Command="{Binding ExportDiagnosticsCommand}"
                            Content="Exportar diagnóstico"
                            IsEnabled="{Binding CanExportDiagnostics}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <ToggleButton VerticalAlignment="Center"
                                  AutomationProperties.Name="Seleccionar acción final"
                                  Command="{Binding ToggleFinalActionCommand}"
                                  IsChecked="{Binding SendEmailAtEnd, Mode=OneWay}"
                                  IsEnabled="{Binding AreControlsEnabled}"
                                  Style="{StaticResource OutlookActionToggleStyle}" />
                </StackPanel>

                <UniformGrid Grid.Row="1"
                             HorizontalAlignment="Stretch"
                             Columns="4">
                <Button Margin="0,0,10,0"
                        AutomationProperties.Name="Configurar credenciales PAM"
                        Command="{Binding ConfigureCredentialsCommand}"
                        Style="{StaticResource NavigationCardButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding CredentialsActionText}" />
                        <TextBlock Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Text="→" />
                    </Grid>
                </Button>

                <Button Margin="10,0"
                        AutomationProperties.Name="Configurar solicitud PAM"
                        Command="{Binding ConfigureRequestCommand}"
                        Style="{StaticResource NavigationCardButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding RequestActionText}" />
                        <TextBlock Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Text="→" />
                    </Grid>
                </Button>

                <Button Margin="10,0,0,0"
                        AutomationProperties.Name="Configurar firma del correo"
                        Command="{Binding ConfigureSignatureCommand}"
                        Style="{StaticResource NavigationCardButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding SignatureActionText}" />
                        <TextBlock Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Text="→" />
                    </Grid>
                </Button>

                <Button x:Name="CollectionsButton"
                        Margin="10,0,0,0"
                        AutomationProperties.Name="Abrir colecciones"
                        Command="{Binding OpenCollectionsCommand}"
                        Style="{StaticResource NavigationCardButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Colecciones" />
                        <TextBlock Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Text="→" />
                    </Grid>
                </Button>
                </UniformGrid>
            </Grid>
        </Grid>

        <Button x:Name="AboutButton"
                Grid.Row="1"
                Width="42"
                Height="42"
                Margin="30,0,0,24"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Panel.ZIndex="10"
                AutomationProperties.Name="Acerca de PAM Automation"
                Command="{Binding OpenAboutCommand}"
                Content="i"
                FontFamily="Segoe UI"
                FontSize="20"
                FontStyle="Italic"
                FontWeight="Bold"
                ToolTip="Acerca de PAM Automation">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Circle"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="21">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Circle" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Circle" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Circle" Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
