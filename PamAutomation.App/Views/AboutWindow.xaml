<Window x:Class="PamAutomation.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de PAM Automation"
        Width="420"
        Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="52"
                    Height="52"
                    Background="{StaticResource NavyBrush}"
                    CornerRadius="17">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="19"
                           FontWeight="Bold"
                           Text="PA"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="23" FontWeight="Bold" Text="PAM Automation"/>
                <TextBlock Margin="0,3,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="BeyondInsight Password Safe"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,0"
                Padding="16,13"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Versión"/>
                <TextBlock Grid.Column="1"
                           Margin="22,0,0,0"
                           HorizontalAlignment="Right"
                           Text="{Binding VersionText, Mode=OneWay}"/>
                <TextBlock Grid.Row="1" Margin="0,11,0,0" FontWeight="SemiBold" Text="Autor"/>
                <TextBlock x:Name="AuthorText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="22,11,0,0"
                           HorizontalAlignment="Right"
                           Text="Hitss Omar Téllez"/>
            </Grid>
        </Border>

        <Button x:Name="CloseButton"
                Grid.Row="3"
                Width="110"
                Height="40"
                HorizontalAlignment="Right"
                Content="Cerrar"
                IsCancel="True"
                IsDefault="True"
                Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</Window>
