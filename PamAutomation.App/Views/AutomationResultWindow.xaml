<Window x:Class="PamAutomation.App.Views.AutomationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" Height="560" MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" ShowActivated="True"
        Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="ResultText" Margin="28,24" Padding="0" FontSize="15"
                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0" Background="Transparent"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 AutomationProperties.Name="Resultado de la automatización"/>

        <Border Grid.Row="1" Background="{StaticResource NeutralSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="CopyStatusText" Margin="0,0,0,10" Visibility="Collapsed"
                           TextWrapping="Wrap" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
                <DockPanel LastChildFill="False">
                    <Button x:Name="CopyRequestIdsButton" DockPanel.Dock="Left"
                            Content="Copiar Request ID" MinWidth="170" Height="40"
                            Style="{StaticResource PrimaryButtonStyle}" Click="CopyRequestIds_Click"/>
                    <Button DockPanel.Dock="Right" Content="Aceptar" MinWidth="110" Height="40"
                            IsDefault="True" IsCancel="True" Click="Accept_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
