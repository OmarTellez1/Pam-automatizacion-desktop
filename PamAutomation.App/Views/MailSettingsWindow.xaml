<Window x:Class="PamAutomation.App.Views.MailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Envío de correo" Width="780" Height="760" MinWidth="680" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="Bold" Text="Configuración de Outlook"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,16" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Text="El contenido se cifra para el usuario actual. Debe incluir {{REQUEST_IDS}} exactamente una vez."/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock FontWeight="SemiBold" Text="Cuenta remitente (SMTP)"/><TextBox x:Name="SmtpBox" Height="36" Margin="0,5,0,12"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock FontWeight="SemiBold" Text="Asunto"/><TextBox x:Name="SubjectBox" Height="36" Margin="0,5,0,12"/></StackPanel>
        </Grid>
        <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Para (separar con punto y coma)"/>
        <TextBox x:Name="ToBox" Grid.Row="4" Height="36" Margin="0,5,0,12"/>
        <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="CC (opcional)"/>
        <TextBox x:Name="CcBox" Grid.Row="6" Height="36" Margin="0,5,0,12"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Width="44" Margin="0,0,6,0" Content="B" FontWeight="Bold" Click="Bold_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Width="44" Margin="0,0,6,0" Content="I" FontStyle="Italic" Click="Italic_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Width="44" Margin="0,0,6,0" Content="U" Click="Underline_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="• Lista" Click="Bullets_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Margin="6,0,0,0" Content="Tabla 2×2" Click="Table_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Margin="6,0,0,0" Content="Pegar imagen" Click="PasteImage_Click" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <RichTextBox x:Name="BodyEditor" Grid.Row="8" Padding="12" VerticalScrollBarVisibility="Auto"
                     AcceptsTab="True" AutomationProperties.Name="Contenido del correo"/>
        <StackPanel Grid.Row="9" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,10,0" Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Margin="0,0,10,0" Content="Guardar y enviar prueba" Click="SaveAndTest_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Validar y guardar" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
