<Window x:Class="PamAutomation.App.Views.MailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar envío de correo" Width="840" Height="800" MinWidth="700" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock FontSize="26" FontWeight="Bold" Text="Configurar envío de correo"/>
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Define los destinatarios y el contenido que acompañará a los Request ID."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Border Padding="16" Background="{StaticResource PrimarySoftBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="9">
                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                        <Run Text="El envío automático requiere Outlook clásico instalado y una sesión iniciada. "/>
                        <Run Text="El nuevo Outlook no es compatible. La cuenta remitente se configura en Editar credenciales."/>
                    </TextBlock>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="26">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Padding="12" Background="{StaticResource SuccessSoftBrush}" CornerRadius="8">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Cuenta remitente: " FontWeight="SemiBold"/>
                                <Run x:Name="SenderAddressRun"/>
                            </TextBlock>
                        </Border>

                        <TextBlock Grid.Row="1" Margin="0,18,0,0" FontWeight="SemiBold" Text="Para"/>
                        <TextBox x:Name="ToBox" Grid.Row="2" Height="42" Margin="0,6,0,4"
                                 AutomationProperties.Name="Destinatarios Para"/>
                        <TextBlock Grid.Row="3" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                   Text="Separa varias direcciones con punto y coma (;)."/>

                        <TextBlock Grid.Row="4" Margin="0,16,0,0" FontWeight="SemiBold" Text="CC (opcional)"/>
                        <TextBox x:Name="CcBox" Grid.Row="5" Height="42" Margin="0,6,0,4"
                                 AutomationProperties.Name="Destinatarios CC opcionales"/>
                        <TextBlock Grid.Row="6" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                   Text="Separa varias direcciones con punto y coma (;)."/>

                        <TextBlock Grid.Row="7" Margin="0,16,0,0" FontWeight="SemiBold" Text="Asunto"/>
                        <TextBox x:Name="SubjectBox" Grid.Row="8" Height="42" Margin="0,6,0,16"
                                 AutomationProperties.Name="Asunto del correo"/>

                        <Grid Grid.Row="9">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="42" Margin="0,0,6,0" Content="B" FontWeight="Bold" Click="Bold_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Width="42" Margin="0,0,6,0" Content="I" FontStyle="Italic" Click="Italic_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Width="42" Margin="0,0,6,0" Content="U" Click="Underline_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Content="• Lista" Click="Bullets_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Margin="6,0,0,0" Content="Tabla 2×2" Click="Table_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Margin="6,0,0,0" Content="Pegar imagen" Click="PasteImage_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Margin="10,0,0,0" Content="Insertar {{REQUEST_IDS}}"
                                        Click="InsertRequestIds_Click" Style="{StaticResource TestButtonStyle}"/>
                            </Grid>
                            <RichTextBox x:Name="BodyEditor" Grid.Row="1" MinHeight="260" Margin="0,10,0,0" Padding="12"
                                         VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                                         TextChanged="BodyEditor_TextChanged"
                                         AutomationProperties.Name="Contenido del correo"/>
                        </Grid>

                        <Border x:Name="MarkerStatusBorder" Grid.Row="10" Margin="0,12,0,0" Padding="10" CornerRadius="8">
                            <TextBlock x:Name="MarkerStatusText" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"/>
                        </Border>
                        <Button Grid.Row="11" MinHeight="54" Margin="0,16,0,0"
                                Content="Guardar configuración  →" Click="Save_Click"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right" MinWidth="120"
                Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</Window>
