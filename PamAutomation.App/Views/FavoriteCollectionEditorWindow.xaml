<Window x:Class="PamAutomation.App.Views.FavoriteCollectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar colección"
        Width="900"
        Height="700"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock FontSize="22" FontWeight="Bold" Text="Configurar colección" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Elige las solicitudes favoritas y define la configuración exclusiva de esta colección." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="Bold" Text="Nombre de la colección" />
                    <TextBox x:Name="CollectionNameBox"
                             Grid.Row="1"
                             Height="38"
                             Margin="0,8,0,14"
                             MaxLength="100"
                             AutomationProperties.Name="Nombre de la colección" />
                    <GroupBox Grid.Row="2" Header="Solicitudes favoritas">
                        <ListBox x:Name="FavoriteSelectionList"
                                 ItemsSource="{Binding Favorites}"
                                 BorderThickness="0"
                                 AutomationProperties.Name="Solicitudes disponibles para la colección">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="8,6"
                                              Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="Fecha de inicio" />
                        <DatePicker x:Name="StartDatePicker" Height="38" Margin="0,8,0,12"
                                    AutomationProperties.Name="Fecha de inicio de la colección" />

                        <TextBlock FontSize="16" FontWeight="Bold" Text="Hora de inicio" />
                        <Grid Margin="0,8,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="HourBox" Height="38" AutomationProperties.Name="Hora de inicio" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="18" FontWeight="Bold" Text=":" />
                            <TextBox x:Name="MinuteBox" Grid.Column="2" Height="38" MaxLength="2"
                                     PreviewTextInput="MinuteBox_PreviewTextInput"
                                     AutomationProperties.Name="Minutos de inicio" />
                            <ComboBox x:Name="MeridiemBox" Grid.Column="4" Height="38"
                                      AutomationProperties.Name="AM o PM">
                                <ComboBoxItem Content="AM" />
                                <ComboBoxItem Content="PM" />
                            </ComboBox>
                        </Grid>

                        <TextBlock FontSize="16" FontWeight="Bold" Text="Duración en horas" />
                        <TextBox x:Name="DurationBox" Height="38" Margin="0,8,0,12"
                                 AutomationProperties.Name="Duración de la colección" />

                        <TextBlock FontSize="16" FontWeight="Bold" Text="Razón de la petición" />
                        <TextBox x:Name="ReasonBox" Height="112" Margin="0,8,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Razón de la colección" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="ValidationBorder" Padding="10" Background="#FFFFEBEE"
                    CornerRadius="8" Visibility="Collapsed">
                <TextBlock x:Name="ValidationText" Foreground="{StaticResource ErrorBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </Border>
            <StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="110" Margin="0,0,10,0" Content="Cancelar" IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="SaveCollectionButton" MinWidth="180" Content="Guardar colección"
                        Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
