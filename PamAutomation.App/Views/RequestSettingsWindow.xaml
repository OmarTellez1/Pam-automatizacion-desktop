<Window x:Class="PamAutomation.App.Views.RequestSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar solicitud" Width="620" Height="650" MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock FontSize="22" FontWeight="Bold" Text="Configurar solicitud"/>
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="La fecha y hora se interpretan en America/Guayaquil."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="Fecha de inicio"/>
                        <TextBlock x:Name="DateDescriptionText" Grid.Column="1" Margin="16,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    </Grid>
                    <DatePicker x:Name="StartDatePicker" Grid.Row="1" Height="38" Margin="0,8,0,14"
                                SelectedDateChanged="StartDatePicker_SelectedDateChanged"
                                AutomationProperties.Name="Fecha de inicio"/>

                    <TextBlock Grid.Row="2" FontSize="16" FontWeight="Bold" Text="Hora de inicio"/>
                    <Grid Grid.Row="3" Margin="0,8,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="hh"/>
                            <ComboBox x:Name="HourBox" Height="38"
                                      AutomationProperties.Name="Hora de inicio del 01 al 12"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="0,18,0,0" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Text=":"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="mm"/>
                            <TextBox x:Name="MinuteBox" Height="38" MaxLength="2"
                                     PreviewTextInput="MinuteBox_PreviewTextInput"
                                     AutomationProperties.Name="Minutos de inicio del 0 al 59"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="AM/PM"/>
                            <ComboBox x:Name="MeridiemBox" Height="38"
                                  AutomationProperties.Name="AM o PM">
                                <ComboBoxItem Content="AM"/><ComboBoxItem Content="PM"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="4" FontSize="16" FontWeight="Bold"
                               Text="Duración de la sesión en horas"/>
                    <TextBox x:Name="DurationBox" Grid.Row="5" Height="38" Margin="0,8,0,14"
                             AutomationProperties.Name="Duración de la sesión en horas"/>

                    <Border x:Name="ValidationBorder" Grid.Row="6" Margin="0,16,0,0" Padding="12"
                            Background="#FFFFEBEE" CornerRadius="8" Visibility="Collapsed">
                        <TextBlock x:Name="ValidationText" Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>

                    <Button x:Name="SaveRequestButton" Grid.Row="7" MinHeight="46" Margin="0,14,0,0"
                            Content="Guardar configuración  →" Click="Save_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right" MinWidth="110"
                Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</Window>
