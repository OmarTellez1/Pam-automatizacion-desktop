<Window x:Class="PamAutomation.App.Views.RequestSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar solicitud" Width="720" Height="760" MinWidth="620" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock FontSize="26" FontWeight="Bold" Text="Configurar solicitud"/>
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="La fecha y hora se interpretan en America/Guayaquil."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" Padding="28" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock FontSize="18" FontWeight="Bold" Text="Fecha de inicio"/>
                        <TextBlock x:Name="DateDescriptionText" Grid.Column="1" Margin="16,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    </Grid>
                    <DatePicker x:Name="StartDatePicker" Grid.Row="1" Height="42" Margin="0,10,0,20"
                                SelectedDateChanged="StartDatePicker_SelectedDateChanged"
                                AutomationProperties.Name="Fecha de inicio"/>

                    <TextBlock Grid.Row="2" FontSize="18" FontWeight="Bold" Text="Hora de inicio"/>
                    <Grid Grid.Row="3" Margin="0,10,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TimeBox" Height="42" Margin="0,0,12,0" Text="09:00"
                                 AutomationProperties.Name="Hora de inicio en formato hora y minutos"/>
                        <ComboBox x:Name="MeridiemBox" Grid.Column="1" Height="42"
                                  AutomationProperties.Name="AM o PM">
                            <ComboBoxItem Content="AM"/><ComboBoxItem Content="PM"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Grid.Row="4" FontSize="18" FontWeight="Bold"
                               Text="Duración de la sesión en horas"/>
                    <TextBox x:Name="DurationBox" Grid.Row="5" Height="42" Margin="0,10,0,20"
                             AutomationProperties.Name="Duración de la sesión en horas"/>

                    <TextBlock Grid.Row="6" FontSize="18" FontWeight="Bold" Text="Razón de la petición"/>
                    <TextBox x:Name="ReasonBox" Grid.Row="7" Height="120" Margin="0,10,0,20"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Razón de la petición"/>

                    <Border Grid.Row="8" Padding="16" Background="{StaticResource PrimarySoftBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                        <StackPanel>
                            <CheckBox x:Name="TestModeBox" Content="Habilitar modo de prueba" FontWeight="SemiBold"/>
                            <TextBlock Margin="22,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Text="Llena y valida los formularios, pero nunca pulsa Submit Request."/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ValidationBorder" Grid.Row="9" Margin="0,16,0,0" Padding="12"
                            Background="#FFFFEBEE" CornerRadius="8" Visibility="Collapsed">
                        <TextBlock x:Name="ValidationText" Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>

                    <Button Grid.Row="10" MinHeight="54" Margin="0,18,0,0"
                            Content="Guardar configuración  →" Click="Save_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Right" MinWidth="120"
                Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</Window>
