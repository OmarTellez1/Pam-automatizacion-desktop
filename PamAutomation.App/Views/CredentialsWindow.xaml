<Window x:Class="PamAutomation.App.Views.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar credenciales"
        Width="1080" Height="720" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Configurar credenciales"/>
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Administra el acceso al PAM y la cuenta remitente de Outlook clásico."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="20" FontWeight="Bold" Text="Credenciales del PAM"/>
                        <Border x:Name="PamConfiguredBorder" Grid.Row="1" Margin="0,18,0,20" Padding="14"
                                Background="{StaticResource SuccessSoftBrush}" CornerRadius="9">
                            <TextBlock x:Name="PamConfiguredText" TextAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Usuario"/>
                        <TextBox x:Name="UsernameBox" Grid.Row="3" Height="42" Margin="0,6,0,14"
                                 AutomationProperties.Name="Usuario PAM"/>

                        <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Contraseña"/>
                        <Grid Grid.Row="5" Margin="0,6,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordBox" Height="42" AutomationProperties.Name="Contraseña PAM"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>
                            <TextBox x:Name="PasswordTextBox" Height="42" Visibility="Collapsed"
                                     TextChanged="PasswordTextBox_TextChanged"/>
                            <Button Grid.Column="1" Width="76" Margin="8,0,0,0" Content="Mostrar"
                                    x:Name="PasswordVisibilityButton" Click="TogglePasswordVisibility_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>

                        <TextBlock Grid.Row="6" FontWeight="SemiBold"
                                   Text="Clave alfanumérica del Two-Factor Authentication" TextWrapping="Wrap"/>
                        <Grid Grid.Row="7" Margin="0,6,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TotpSeedBox" Height="42" AutomationProperties.Name="Clave alfanumérica TOTP"
                                         PasswordChanged="TotpSeedBox_PasswordChanged"/>
                            <TextBox x:Name="TotpSeedTextBox" Height="42" Visibility="Collapsed"
                                     TextChanged="TotpSeedTextBox_TextChanged"/>
                            <Button Grid.Column="1" Width="76" Margin="8,0,0,0" Content="Mostrar"
                                    x:Name="TotpVisibilityButton" Click="ToggleTotpVisibility_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                        <TextBlock Grid.Row="8" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Usa la clave alfanumérica de configuración. No ingreses el código temporal de 6 dígitos."/>

                        <StackPanel Grid.Row="9" Margin="0,18,0,0">
                            <Border x:Name="PamOperationBorder" Margin="0,0,0,12" Padding="12" CornerRadius="8"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="PamOperationSpinner"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource LoadingSpinnerStyle}"
                                                    Visibility="Collapsed"/>
                                    <TextBlock x:Name="PamOperationText" Grid.Column="1"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </Grid>
                            </Border>
                            <Button x:Name="SavePamButton" MinHeight="54" Content="Guardar cambios y probar acceso  →"
                                    Click="SavePam_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="20" FontWeight="Bold" Text="Cuenta de Outlook"/>
                        <Border Grid.Row="1" Margin="0,18,0,14" Padding="16" Background="{StaticResource PrimarySoftBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="9">
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="Esta configuración es opcional. Requiere Outlook clásico instalado y una sesión iniciada en esta misma cuenta de Windows. No se guarda ninguna contraseña de Outlook."/>
                        </Border>
                        <Border x:Name="OutlookConfiguredBorder" Grid.Row="2" Margin="0,0,0,20" Padding="14"
                                Background="{StaticResource SuccessSoftBrush}" CornerRadius="9">
                            <TextBlock x:Name="OutlookConfiguredText" TextAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Tu correo de Outlook"/>
                        <TextBox x:Name="OutlookSmtpBox" Grid.Row="4" Height="42" Margin="0,6,0,5"
                                 AutomationProperties.Name="Tu correo de Outlook"/>
                        <TextBlock Grid.Row="5" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                                   Text="Debe coincidir exactamente con la cuenta iniciada en Outlook clásico."/>
                        <Border x:Name="OutlookOperationBorder" Grid.Row="6" Margin="0,18,0,0" Padding="12" CornerRadius="8"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl x:Name="OutlookOperationSpinner"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource LoadingSpinnerStyle}"
                                                Visibility="Collapsed"/>
                                <TextBlock x:Name="OutlookOperationText" Grid.Column="1"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="8" Margin="0,20,0,0">
                            <Button x:Name="VerifyOutlookButton" MinHeight="54"
                                    Content="Guardar cambios y verificar Outlook  →"
                                    Click="VerifyOutlook_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button x:Name="TestOutlookButton" MinHeight="50" Margin="0,12,0,0"
                                    Content="Enviar correo de prueba" Click="TestOutlook_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            <TextBlock Margin="0,8,0,0" TextAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="El correo de prueba se enviará a la misma cuenta configurada."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Button Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right" MinWidth="120"
                Content="Cerrar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</Window>
