<Window x:Class="PamAutomation.App.Views.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credenciales PAM" Width="540" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="Credenciales PAM"/>
        <TextBlock x:Name="HelpText" Grid.Row="1" Margin="0,8,0,20" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Usuario PAM"/>
        <TextBox x:Name="UsernameBox" Grid.Row="3" Height="38" Margin="0,6,0,14" AutomationProperties.Name="Usuario PAM"/>
        <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Contraseña PAM"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="5" Height="38" Margin="0,6,0,14" AutomationProperties.Name="Contraseña PAM"/>
        <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Clave Base32 de enrolamiento"/>
        <PasswordBox x:Name="TotpSeedBox" Grid.Row="7" Height="38" Margin="0,6,0,4" AutomationProperties.Name="Clave Base32 TOTP"/>
        <TextBlock Grid.Row="8" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                   Text="Introduce la clave Base32 de Microsoft Authenticator, no el código temporal de seis dígitos."/>
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,10,0" Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Guardar de forma segura" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
