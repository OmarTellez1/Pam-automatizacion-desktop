<Window x:Class="PamAutomation.App.Views.FavoritesCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colecciones"
        Width="680"
        Height="620"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Colecciones" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource BodyTextStyle}"
                       Text="Obtén tus solicitudes favoritas para preparar colecciones personalizadas." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Solicitudes favoritas" />

                <Grid Grid.Row="1" Margin="0,14,0,14">
                    <Border x:Name="EmptyFavoritesState"
                            Padding="20"
                            Background="{StaticResource NeutralSurfaceBrush}"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Todavía no hay solicitudes favoritas guardadas."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ListBox x:Name="FavoritesList"
                             ItemsSource="{Binding Favorites}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             AutomationProperties.Name="Solicitudes favoritas obtenidas">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="10,7"
                                           FontSize="14"
                                           Text="{Binding DisplayName}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Border Padding="10,8" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource NeutralSurfaceBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Background" Value="#FFFFEBEE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding StatusMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ProgressBar Height="4"
                                 Margin="0,10,0,0"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource RunProgressBarStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <Button x:Name="RefreshFavoritesButton"
                            MinHeight="46"
                            Margin="0,12,0,0"
                            AutomationProperties.Name="Obtener o actualizar solicitudes favoritas"
                            Command="{Binding RefreshCommand}"
                            Content="{Binding RefreshButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="2"
                MinWidth="110"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Content="Cerrar"
                IsCancel="True"
                Style="{StaticResource SecondaryButtonStyle}" />
    </Grid>
</Window>
