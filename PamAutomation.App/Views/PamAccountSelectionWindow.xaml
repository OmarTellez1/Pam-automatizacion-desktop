<Window x:Class="PamAutomation.App.Views.PamAccountSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceder a PAM" Width="560" Height="480" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="26" FontWeight="Bold" Text="Elige un usuario PAM"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,18" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Esta elección solo se usará para abrir esta sesión. No cambia el usuario de la automatización."
                   TextWrapping="Wrap"/>

        <ListBox x:Name="AccountsList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                 SelectionChanged="AccountsList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding HasCredentials}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,9"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="15,12" Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Account.Name}"/>
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding RoleText}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding CredentialText}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Width="100" Height="40" Margin="0,0,10,0" Content="Cancelar"
                    IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="ContinueButton" Grid.Column="2" Width="120" Height="40" Content="Continuar"
                    IsDefault="True" IsEnabled="False" Click="Continue_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
