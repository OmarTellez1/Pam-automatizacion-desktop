<Window x:Class="PamAutomation.App.Views.RepeatedPendingDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solicitudes repetidas en Pending"
        Width="760" Height="430" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="True"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="26" FontWeight="Bold" Text="Ya existen solicitudes iguales"/>
        <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,10,0,0"
                   FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2" Margin="0,20,0,0" Padding="18,14"
                Background="{StaticResource PendingBackgroundBrush}"
                BorderBrush="{StaticResource PendingTextBrush}" BorderThickness="1" CornerRadius="10">
            <TextBlock x:Name="ReuseAvailabilityText" TextWrapping="Wrap"
                       Foreground="{StaticResource PendingTextBrush}" FontWeight="SemiBold"/>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,18,0,0" VerticalAlignment="Top"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Text="Elige una sola acción. No se creará ni enviará nada hasta que confirmes una opción."/>

        <Grid Grid.Row="4" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="0" Height="54" Margin="0,0,10,0"
                    IsCancel="True" Style="{StaticResource SecondaryButtonStyle}">
                <TextBlock Text="Cancelar automatización" TextAlignment="Center" TextWrapping="Wrap"/>
            </Button>
            <Button x:Name="SubmitAgainButton" Grid.Column="1" Height="54" Margin="5,0,5,0"
                    Click="SubmitAgain_Click" Style="{StaticResource SecondaryButtonStyle}">
                <TextBlock Text="Automatizar con solicitudes repetidas" TextAlignment="Center" TextWrapping="Wrap"/>
            </Button>
            <Button x:Name="ReuseButton" Grid.Column="2" Height="54" Margin="10,0,0,0"
                    Click="ReuseExisting_Click" Style="{StaticResource PrimaryButtonStyle}">
                <TextBlock Text="Usar Request ID existentes y enviar correo" TextAlignment="Center" TextWrapping="Wrap"/>
            </Button>
        </Grid>
    </Grid>
</Window>
