<Window x:Class="PamAutomation.App.Views.PamAccountNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear usuario principal" Width="500" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="25" FontWeight="Bold" Text="Crea tu usuario principal"/>
        <TextBlock x:Name="ExplanationText" Grid.Row="1" Margin="0,8,0,20" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Este nombre identificará al propietario de la automatización. Podrás editarlo después."
                   TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Margin="0,0,0,6" FontWeight="SemiBold" Text="Nombre"/>
        <TextBox x:Name="NameBox" Grid.Row="3" Height="40" Padding="10,7" MaxLength="80"/>
        <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Height="38" Margin="0,0,10,0" Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Width="135" Height="38" Content="Continuar" IsDefault="True" Click="Continue_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
