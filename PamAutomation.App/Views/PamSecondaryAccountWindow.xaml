<Window x:Class="PamAutomation.App.Views.PamSecondaryAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear usuario PAM" Width="560" Height="570" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="25" FontWeight="Bold" Text="Crear usuario PAM"/>
        <TextBlock x:Name="HelpText" Grid.Row="1" Margin="0,7,0,18" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Esta cuenta solo se utilizará con Acceder a PAM. No podrá crear solicitudes automáticas."
                   TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Margin="0,0,0,5" FontWeight="SemiBold" Text="Nombre descriptivo"/>
        <TextBox x:Name="NameBox" Grid.Row="3" Height="38" Padding="9,6" MaxLength="80"/>
        <TextBlock Grid.Row="4" Margin="0,13,0,5" FontWeight="SemiBold" Text="Usuario PAM"/>
        <TextBox x:Name="UsernameBox" Grid.Row="5" Height="38" Padding="9,6" MaxLength="513"/>
        <Grid Grid.Row="6" Margin="0,13,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Contraseña PAM"/>
                <PasswordBox x:Name="PasswordBox" Height="38" Padding="9,6"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Semilla TOTP"/>
                <PasswordBox x:Name="TotpSeedBox" Height="38" Padding="9,6"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="EditHelpText" Grid.Row="7" Margin="0,9,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Al editar, deja un secreto vacío para conservar el valor protegido actual."
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="ValidationText" Grid.Row="8" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Height="38" Margin="0,0,10,0" Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Width="145" Height="38" Content="Guardar usuario" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
