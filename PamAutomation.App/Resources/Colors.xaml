<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#F4F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="PrimaryColor">#1769E0</Color>
    <Color x:Key="PrimaryHoverColor">#125BC4</Color>
    <Color x:Key="PrimaryPressedColor">#0E4DA8</Color>
    <Color x:Key="PrimarySoftColor">#E8F1FD</Color>
    <Color x:Key="TextPrimaryColor">#172033</Color>
    <Color x:Key="TextSecondaryColor">#536078</Color>
    <Color x:Key="TextMutedColor">#7A869D</Color>
    <Color x:Key="BorderColor">#DDE4EF</Color>
    <Color x:Key="NeutralSurfaceColor">#F8FAFD</Color>
    <Color x:Key="PendingBackgroundColor">#FFF4D6</Color>
    <Color x:Key="PendingTextColor">#8A6200</Color>
    <Color x:Key="SuccessColor">#18875B</Color>
    <Color x:Key="SuccessSoftColor">#E8F6F0</Color>
    <Color x:Key="ErrorColor">#C33B4A</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="NeutralSurfaceBrush" Color="{StaticResource NeutralSurfaceColor}" />
    <SolidColorBrush x:Key="PendingBackgroundBrush" Color="{StaticResource PendingBackgroundColor}" />
    <SolidColorBrush x:Key="PendingTextBrush" Color="{StaticResource PendingTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
</ResourceDictionary>
